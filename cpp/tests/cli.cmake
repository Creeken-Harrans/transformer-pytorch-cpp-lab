file(MAKE_DIRECTORY "${DIR}")
function(run_ok)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Command failed (${code}): ${ARGN}\n${out}\n${err}")
  endif()
endfunction()
function(run_bad)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(code EQUAL 0 OR err STREQUAL "")
    message(FATAL_ERROR "Invalid CLI input was not rejected with readable stderr: ${ARGN}")
  endif()
endfunction()
run_ok("${FIXTURE}" create "${DIR}/case.tlab")
run_ok("${CLI}" inspect "${DIR}/case.tlab" "${DIR}/result.tlab")
run_ok("${FIXTURE}" inspect "${DIR}/case.tlab" "${DIR}/result.tlab")
run_ok("${CLI}" train "${DIR}/case.tlab" "${DIR}/zero.tlab" --steps 0)
run_ok("${FIXTURE}" same "${DIR}/case.tlab" "${DIR}/zero.tlab")
run_ok("${CLI}" train "${DIR}/case.tlab" "${DIR}/trained.tlab" --steps 12)
run_ok("${FIXTURE}" trained "${DIR}/case.tlab" "${DIR}/trained.tlab")
run_ok("${FIXTURE}" eos "${DIR}/eos.tlab")
execute_process(COMMAND "${CLI}" generate "${DIR}/eos.tlab" --bos 1 --eos 2 --max-new-tokens 5
  RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT code EQUAL 0 OR NOT out STREQUAL "1 2\n1 2\n")
  message(FATAL_ERROR "EOS CLI output mismatch: ${code} ${out} ${err}")
endif()
execute_process(COMMAND "${CLI}" generate "${DIR}/eos.tlab"
  RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT code EQUAL 0 OR NOT out STREQUAL "1 2\n1 2\n")
  message(FATAL_ERROR "Default BOS/EOS/budget mismatch: ${code} ${out} ${err}")
endif()
run_bad("${CLI}" inspect "${DIR}/missing.tlab" "${DIR}/ignored.tlab")
run_bad("${CLI}" train "${DIR}/case.tlab" "${DIR}/ignored.tlab" --steps -1)
run_bad("${CLI}" train "${DIR}/case.tlab" "${DIR}/ignored.tlab" --steps 1junk)
run_bad("${CLI}" generate "${DIR}/case.tlab" --bos 0 --eos 2 --max-new-tokens 3)
run_bad("${CLI}" generate "${DIR}/case.tlab" --bos 1 --eos 2 --max-new-tokens 32)
run_bad("${CLI}" nonsense)
